<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glance" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
    <style name="Theme.Glance.Settings" parent="Theme.AppCompat.DayNight">
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/surface</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- Dark bar icons on the light page, light ones at night (as the main screen; stock Android leaves them white). -->
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>
    <bool name="light_bars">true</bool>
</resources>
